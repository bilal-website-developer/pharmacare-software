{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pharmacare-web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "developer-dashboard": {
      "root": "developer-dashboard",
      "framework": "vite",
      "buildCommand": "npm run build -- --base=/developer/",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/developer",
      "destination": {
        "service": "developer-dashboard",
        "path": "/"
      }
    },
    {
      "source": "/developer/:path*",
      "destination": {
        "service": "developer-dashboard",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "pharmacare-web"
      }
    }
  ]
}
